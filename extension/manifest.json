{
  "manifest_version": 3,
  "name": "MediaFlow Discord RPC Bridge",
  "version": "1.7.0",
  "description": "MediaFlow Discord RPC bridge with page-specific counts, Old System presence, and exact-title Dashboard presence.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://alexgodly.github.io/MediaFlow/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://alexgodly.github.io/MediaFlow/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
