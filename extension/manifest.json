{
  "manifest_version": 3,
  "name": "MediaFlow Discord RPC Bridge",
  "version": "1.4.0",
  "description": "Reads MediaFlow's rendered page plus its own local recovery cache and relays Discord Rich Presence to the local tray companion.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://alexgodly.github.io/MediaFlow/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://alexgodly.github.io/MediaFlow/*"],
      "js": ["relay.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
